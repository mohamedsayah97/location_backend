generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Booking {
  id         Int      @id @default(autoincrement())
  userId     Int
  vehicleId  Int
  startDate  DateTime
  endDate    DateTime
  totalPrice Decimal @db.Decimal(10, 2)
  status     BookingStatus @default(PENDING)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}